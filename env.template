# ===== Telegram Bot配置 =====
# 从 @BotFather 获取的 Bot Token（必填）
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_USERNAME=YourMerchantBot

# Bot运行模式: polling 或 webhook
BOT_MODE=polling

# Webhook配置 (仅webhook模式需要)
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_PORT=8443

# ===== 数据库配置 =====
# 开发环境使用 SQLite（简单，无需安装数据库服务器）
DATABASE_URL=sqlite+aiosqlite:///./merchant_bot.db

# 生产环境使用 PostgreSQL
# DATABASE_URL=postgresql+asyncpg://merchant_user:your_password@localhost:5432/merchant_bot_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== Redis配置 =====
# Redis连接（必填）
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ===== Celery配置 =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== OCR配置 =====
# OCR引擎选择: tesseract(推荐Linux/Docker), paddleocr(Windows), aliyun, tencentcloud, baidu
OCR_ENGINE=tesseract

# PaddleOCR配置
PADDLEOCR_USE_GPU=false
PADDLEOCR_LANG=ch

# 阿里云OCR配置（可选）
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_REGION=cn-shanghai

# 腾讯云OCR配置（可选）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou

# 百度OCR配置（可选）
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ===== 管理员配置 =====
# 管理员的Telegram用户ID，多个用逗号分隔（必填）
# 获取方式：在Telegram中找 @userinfobot，发送任意消息获取ID
ADMIN_USER_IDS=123456789,987654321

# 超级管理员（拥有所有权限）
SUPER_ADMIN_ID=123456789

# ===== 应用配置 =====
APP_NAME=商户管理机器人
APP_ENV=development
DEBUG=true

# API服务器配置
API_HOST=0.0.0.0
API_PORT=8000

# ===== 后端API配置 =====
# Java后端API地址（必填）
BACKEND_API_URL=http://127.0.0.1:60010/httpapi/telegram
BACKEND_API_TIMEOUT=10

# ===== 安全配置 =====
# 请运行 python generate_keys.py 生成以下密钥（必填）
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=your-encryption-key-32-characters

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/app.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

# ===== 业务配置 =====
MERCHANT_CODE_EXPIRE_MINUTES=30
BALANCE_CACHE_TTL=60
MAX_IMAGE_SIZE_MB=10
MAX_ORDER_RESULTS=10
BROADCAST_DELAY_MS=100

# ===== 限流配置 =====
RATE_LIMIT_PER_USER=20
OCR_RATE_LIMIT_PER_HOUR=50

# ===== 第三方服务配置 =====
SENTRY_DSN=
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# ===== 文件存储配置 =====
UPLOAD_DIR=uploads
TEMP_DIR=temp
STORAGE_TYPE=local

# 阿里云OSS配置（可选）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=

# ===== 功能开关 =====
# 如果暂时不想使用OCR功能，设置为 false
ENABLE_OCR=false
ENABLE_BALANCE_QUERY=true
ENABLE_BROADCAST=true
REQUIRE_MERCHANT_AUTH=true

# ===== 数据库备份配置 =====
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=backups/

